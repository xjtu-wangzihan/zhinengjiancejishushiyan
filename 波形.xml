		<script>
<![CDATA[Rem Write Drawing Codes Here  
Dim wave(160) 
pi=3.141 
amp=GWVI.ReadPort(2) 
'amp=200 
b=GWVI.ReadPort(3) 
imax=150 
dt=0.015/imax 
For i=0 To imax 
  t=2*pi*100*i*dt 
  wave(i)=amp*Sin(t)       
Next 
GWVI.DrawLine 40,220,1000,220,0 
GWVI.DrawLine 40,120,40,320,0 
GWVI.WriteText 44,120,0," 1000" 
GWVI.WriteText 44,310,0,"-1000" 
GWVI.WriteText 30,213,0,"0" 
GWVI.WriteText 320,228,0,"0.03" 
GWVI.WriteText 320*2,228,0,"0.06" 
'GWVI.WriteText 44,200,0," Cstr(amp)" 
f=100/1000 
ixishu=100*b 
For i=0 To imax 
  x1=40+i*ixishu 
  y1=220-wave(i)*f 
  x2=40+(i+1)*ixishu 
  y2=220-wave(i+1)*f 
  GWVI.DrawLine x1,y1,x2,y2,12 
Next 
 
 
 
 
 




]]></script>
