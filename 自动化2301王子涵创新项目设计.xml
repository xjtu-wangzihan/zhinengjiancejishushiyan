		<script>
<![CDATA[Rem Write VBScript Codes Here  
k=GWVI.ReadPort(2) 
 
b=GWVI.ReadPort(3) 
 
y=GWVI.ReadPort(4) 
 
If k=0 Then 
 
GWVI.WriteText 450,500,12,"请先标定！" 
 
Else 
 
x=(y-b)/k 
 
GWVI.WritePort 5,x 
 
End If 
If x<250 Then 
GWVI.WriteText 250,450,2,"                               " 
Else 
GWVI.WriteText 250,453,2,"大于250g,超重" 
End If 
 
 
 
 
 











]]></script>
