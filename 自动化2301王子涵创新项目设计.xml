		<script>
<![CDATA[Rem Write VBScript Codes Here  
Dim k,b 
 
x1=GWVI.ReadPort(2) 
x2=GWVI.ReadPort(3) 
y1=GWVI.ReadPort(4) 
y2=GWVI.ReadPort(5) 
If x1=x2 Then 
GWVI.WriteText 450,500,12,"请先标定!" 
Else 
k1=(y2-y1)/(x2-x1) 
k=k1 
b=y1-k*x1 
 
GWVI.WritePort 6,k 
 
GWVI.WritePort 7,b 
End If 
 
 
 
 
 











]]></script>
