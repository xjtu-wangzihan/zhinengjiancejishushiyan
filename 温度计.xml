		<script>
<![CDATA[Sub temperature(x,y,maxval,minval) 
imax = 10 
v = GWVI.ReadPort(2) 
For i = 0 To imax 
GWVI.DrawLine x + 30, y + i * 15, x + 35, y + i * 15, 0 
Next 
GWVI.WriteText x, y - 5, 0, CStr(maxval) 
GWVI.WriteText x, y + 145, 0, CStr(minval) 
GWVI.FillRectangle x + 45, y, 26, 150, 1 
GWVI.FillCircle x + 45 + 12, y + 150 + 13, 16, 12 
h = v * 150 / (maxval - minval) 
GWVI.FillRectangle x + 45, y + 150 - h, 26, h, 12 
End Sub 
 
Sub drawit() 
temperature 150, 40, 80, 0 
End Sub 
 
drawit

]]></script>
